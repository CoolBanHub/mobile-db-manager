{
  "name": "@dbx-app/android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "sync": "pnpm build && cap sync android",
    "open": "cap open android",
    "android:build:debug": "pnpm sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource-variable/azeret-mono": "5.3.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  }
}
